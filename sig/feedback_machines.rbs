module FeedbackMachines
  VERSION: String

  # The core's `Refusal`: the call was not honoured and changed nothing.
  # :not_finite, the sample is NaN or infinite.
  # :invalid_duration, the elapsed time is zero.
  # :overflow, the sample is finite but a term of the calculation is not.
  type refusal = :not_finite | :invalid_duration | :overflow

  # The core's `Band`.
  type band = :low | :high

  # The core's `Gains`. `new` mirrors `Gains::new(p, i, d)`: it raises
  # RangeError unless every gain is finite and nonnegative, TypeError for
  # anything but a Float or Integer (a Rational included). The fields are
  # stored as Floats. Sealed (subclassing raises TypeError, no `allocate`);
  # the binding reads only instances of exactly this class and re-checks
  # their fields, so a forged value raises.
  class Gains < Data
    attr_reader p: Float
    attr_reader i: Float
    attr_reader d: Float
    def self.new: ((Float | Integer) p, (Float | Integer) i, (Float | Integer) d) -> Gains
                | (p: (Float | Integer), i: (Float | Integer), d: (Float | Integer)) -> Gains
  end

  # The core's `Limits`. `new` mirrors `Limits::new(min, max)`: it raises
  # RangeError unless both are finite and min < max, TypeError for anything
  # but a Float or Integer (a Rational included). The fields are stored as
  # Floats. Sealed and re-checked by the binding like Gains.
  class Limits < Data
    attr_reader min: Float
    attr_reader max: Float
    def self.new: ((Float | Integer) min, (Float | Integer) max) -> Limits
                | (min: (Float | Integer), max: (Float | Integer)) -> Limits
  end

  # The core's `Pid`.
  class Pid
    # The core's `Pid::new(gains, limits)`. Raises TypeError unless given
    # instances of exactly Gains and Limits, RangeError if their fields fail
    # the core's constructors.
    def self.new: (Gains gains, Limits limits) -> Pid
    def gains: () -> Gains
    def limits: () -> Limits

    # The core's `Pid::step(error, elapsed)`. `elapsed` is the span since the
    # previous sample in Integer nanoseconds. Honoured: the output, a Float
    # within the limits. Refused: :not_finite (error is NaN or infinite),
    # :invalid_duration (elapsed is zero) or :overflow; the controller is
    # unchanged. Never nil. Raises TypeError for a non-Integer elapsed or a
    # error that is not a Float or Integer, RangeError for an elapsed outside 0..2**64-1,
    # FrozenError on a frozen controller, all before the controller is
    # stepped. Records no clock: `elapsed` is a span, not an instant.
    def step: ((Float | Integer) error, Integer elapsed) -> (Float | refusal)
  end

  # The core's `Hysteresis`.
  class Hysteresis
    # The core's `Hysteresis::new(limits)`: starts :low. Raises TypeError
    # unless given an instance of exactly Limits, RangeError if its fields
    # fail the core's constructor.
    def self.new: (Limits limits) -> Hysteresis
    def limits: () -> Limits

    # The side the band is on now. A query.
    def state: () -> band

    # The core's `Hysteresis::observe(value)`. Honoured: the side the band is
    # on after the measurement. Refused: :not_finite, and the band keeps its
    # side. Never nil. Raises TypeError for anything but a Float or Integer, FrozenError on a
    # frozen band, before the band moves. Records no clock.
    def observe: ((Float | Integer) value) -> (band | :not_finite)
  end
end
